# このファイルをコピーして .env を作る（.env は git 管理外）
#   cp .env.example .env

# --- データベース ---
# ローカル MySQL
DATABASE_URL="mysql://root@127.0.0.1:3306/keihi_system"
#
# Railway の MySQL を使う場合は、Railway が用意する変数を参照する:
#   DATABASE_URL=${{MySQL.MYSQL_URL}}
#
# TiDB Cloud を使う場合（TLS 必須なので sslaccept=strict を付ける）:
#   DATABASE_URL="mysql://<user>:<password>@<host>:4000/<db>?sslaccept=strict"

# 同時接続数（マネージド DB の上限に合わせる。未指定なら 5）
# DATABASE_CONNECTION_LIMIT="5"

# --- セッション ---
# 32バイト以上のランダム文字列。生成: openssl rand -base64 32
AUTH_SECRET="local-dev-only-secret-please-replace-in-production-0123456789"

# --- ファイルストレージ (Cloudflare R2 / S3互換) ---
# 本番では必須。未設定だとローカルの ./.storage に保存され、
# Railway などのコンテナでは再デプロイのたびに領収書が消える。
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""


# --- シードで作る初期アカウント ---
# ログイン画面で入力する名前。未指定なら owner / staff になる
SEED_OWNER_NAME=""
SEED_USER_NAME=""
